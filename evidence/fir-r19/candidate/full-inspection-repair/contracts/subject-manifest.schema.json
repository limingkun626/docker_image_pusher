{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subject Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "subject_kind",
    "subject_root",
    "adapter_id",
    "adapter_version",
    "adapter_contract_digest",
    "knowledge_pack_id",
    "knowledge_pack_digest",
    "detector_pack_digest",
    "defect_taxonomy_digest",
    "taxonomy_coverage_digest",
    "fingerprint_registry_digest",
    "evidence_policy_digest",
    "tree_digest",
    "config_digest",
    "generation",
    "snapshot_digest",
    "root_generation",
    "directories",
    "files",
    "character_coverage_digest",
    "codepoint_count",
    "punctuation_count",
    "uncovered_character_count",
    "coverage_gap_count"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "subject_id": { "type": "string", "minLength": 1 },
    "subject_kind": {
      "enum": ["SKILL", "PLAN", "ARTICLE", "PROJECT", "OTHER"]
    },
    "subject_root": { "type": "string", "minLength": 1 },
    "adapter_id": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "adapter_contract_digest": { "$ref": "#/$defs/sha256" },
    "knowledge_pack_id": { "type": "string", "minLength": 1 },
    "knowledge_pack_digest": { "$ref": "#/$defs/sha256" },
    "detector_pack_digest": { "$ref": "#/$defs/sha256" },
    "defect_taxonomy_digest": { "$ref": "#/$defs/sha256" },
    "taxonomy_coverage_digest": { "$ref": "#/$defs/sha256" },
    "fingerprint_registry_digest": { "$ref": "#/$defs/sha256" },
    "evidence_policy_digest": { "$ref": "#/$defs/sha256" },
    "tree_digest": { "$ref": "#/$defs/sha256" },
    "config_digest": { "$ref": "#/$defs/sha256" },
    "generation": { "type": "integer", "minimum": 1 }
    ,
    "snapshot_digest": { "$ref": "#/$defs/sha256" },
    "root_generation": { "$ref": "#/$defs/sha256" },
    "directories": { "type": "array" },
    "files": { "type": "array" },
    "character_coverage_digest": { "$ref": "#/$defs/sha256" },
    "codepoint_count": { "type": "integer", "minimum": 0 },
    "punctuation_count": { "type": "integer", "minimum": 0 },
    "uncovered_character_count": { "type": "integer", "minimum": 0 },
    "coverage_gap_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
