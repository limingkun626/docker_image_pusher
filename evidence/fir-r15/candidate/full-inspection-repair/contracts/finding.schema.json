{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-inspection-repair.local/contracts/finding.schema.json",
  "title": "Finding / Risk Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "risk_id",
    "invariant_id",
    "defect_class_id",
    "taxonomy_category_id",
    "subject_id",
    "source_id",
    "severity",
    "message",
    "mechanism",
    "affected_refs",
    "root_cause_id",
    "status",
    "evidence_refs",
    "evidence_sha256",
    "closed_by",
    "closed_at",
    "verification_check",
    "residual_risk"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "risk_id": { "type": "string", "minLength": 1 },
    "invariant_id": { "type": "string", "minLength": 1 },
    "defect_class_id": { "type": "string", "minLength": 1 },
    "taxonomy_category_id": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["Critical", "High", "Medium", "Low"] },
    "message": { "type": "string", "minLength": 1 },
    "mechanism": { "type": "string", "minLength": 1 },
    "affected_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "root_cause_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "OPEN",
        "FIXED",
        "FALSE_POSITIVE_WITH_PROOF",
        "PREVENTED_BY_VERIFIED_GUARD",
        "SUPERSEDED_BY_VERIFIED_CHANGE"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_sha256": { "$ref": "#/$defs/sha256" },
    "closed_by": { "type": ["string", "null"] },
    "closed_at": { "type": ["string", "null"], "format": "date-time" },
    "verification_check": { "type": ["string", "null"] },
    "residual_risk": { "type": "null" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "OPEN" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "closed_by": { "type": "null" },
          "closed_at": { "type": "null" },
          "verification_check": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FIXED",
              "FALSE_POSITIVE_WITH_PROOF",
              "PREVENTED_BY_VERIFIED_GUARD",
              "SUPERSEDED_BY_VERIFIED_CHANGE"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "closed_by": { "$ref": "#/$defs/sha256" },
          "closed_at": { "type": "string", "format": "date-time" },
          "verification_check": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:candidate|receipt|rerun|review|test):"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
