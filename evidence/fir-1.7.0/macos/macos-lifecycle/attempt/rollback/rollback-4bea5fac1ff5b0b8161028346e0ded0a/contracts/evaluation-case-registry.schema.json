{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-inspection-repair.local/contracts/evaluation-case-registry.schema.json",
  "title": "FIR Evaluation Case Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases", "registry_digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "cases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_digest", "runner_digest", "tool_digest"],
        "properties": {
          "fixture_digest": { "$ref": "#/$defs/digest" },
          "runner_digest": { "$ref": "#/$defs/digest" },
          "tool_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "registry_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
