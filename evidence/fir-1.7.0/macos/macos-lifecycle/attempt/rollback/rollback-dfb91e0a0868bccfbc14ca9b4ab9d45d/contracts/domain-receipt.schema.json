{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-inspection-repair.local/contracts/domain-receipt.schema.json",
  "title": "FIR Domain Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "domain_id",
    "status",
    "runner_id",
    "runner_version",
    "runner_digest",
    "signer_id",
    "issuer",
    "signature_receipt",
    "scope_id",
    "candidate_digest",
    "installer_digest",
    "environment_digest",
    "command",
    "command_digest",
    "raw_evidence",
    "evidence_sha256",
    "started_at",
    "finished_at",
    "fresh_until",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "domain-receipt" },
    "domain_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["VERIFIED", "BLOCKED", "UNVERIFIED"] },
    "runner_id": { "type": "string", "minLength": 1 },
    "runner_version": { "type": "string", "minLength": 1 },
    "runner_digest": { "$ref": "#/$defs/digest" },
    "signer_id": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "signature_receipt": { "$ref": "#/$defs/signature_receipt" },
    "scope_id": { "type": "string", "minLength": 1 },
    "candidate_digest": { "$ref": "#/$defs/digest" },
    "installer_digest": { "$ref": "#/$defs/digest" },
    "environment_digest": { "$ref": "#/$defs/digest" },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "command_digest": { "$ref": "#/$defs/digest" },
    "raw_evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "evidence_sha256": { "$ref": "#/$defs/digest" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "fresh_until": { "$ref": "#/$defs/timestamp" },
    "receipt_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "signer_id",
        "issuer",
        "verification_method",
        "receipt_digest"
      ],
      "properties": {
        "receipt_id": { "type": "string", "minLength": 1 },
        "signer_id": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "verification_method": {
          "enum": ["sigstore-keyless", "ed25519-detached", "trusted-runner"]
        },
        "receipt_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
