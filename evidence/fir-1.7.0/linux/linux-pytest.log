    def test_runtime_repeatability_is_derived_from_digest_equality() -> None:
        snapshot = {
            "files": {
                "fixture.py": (
                    "import os\n"
                    "def run():\n"
                    "    os.system('echo forbidden')\n"
                    "    return True\n"
                )
            },
            "runtime_case": {
                "call": "run",
                "args": [],
                "declared_return": True,
                "forbidden_calls": ["system"],
            },
        }
