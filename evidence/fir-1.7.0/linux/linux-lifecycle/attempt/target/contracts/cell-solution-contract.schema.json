{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/fir/r2/cell-solution-contract.schema.json",
  "title": "FIR R2 executable cell solution contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "solution_id",
    "scope_kind",
    "cell_id",
    "risk_id",
    "capability_id",
    "priority",
    "evidence",
    "action",
    "terminal_state",
    "mechanism_id",
    "exact_module",
    "interface",
    "schema_state_file_impact",
    "tests",
    "resource_limits",
    "success_state",
    "failure_state",
    "failure_consequence",
    "rollback",
    "real_benefit",
    "non_extrapolation",
    "policy_version",
    "policy_digest"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "solution_id": {"type": "string", "pattern": "^SOL-CELL-[0-9]{2}$"},
    "scope_kind": {"const": "CELL"},
    "cell_id": {"type": "string", "pattern": "^SKILL:[A-Z_]+:[A-Z_]+$"},
    "risk_id": {"type": ["string", "null"]},
    "capability_id": {"type": ["string", "null"]},
    "primary_cell_id": {"type": ["string", "null"]},
    "priority": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "action": {
      "enum": [
        "KEEP",
        "REPLACE",
        "SUPPLEMENT",
        "ENHANCE",
        "MERGE",
        "BORROW_ONLY",
        "REJECT"
      ]
    },
    "terminal_state": {
      "enum": [
        "COVERED_BY_NATIVE_DETECTOR",
        "COVERED_BY_EXACT_ADAPTER",
        "COVERED_BY_INDEPENDENT_ORACLE",
        "MERGED_WITH_PRIMARY_CELL",
        "NOT_APPLICABLE_WITH_PROOF"
      ]
    },
    "mechanism_id": {"type": "string", "minLength": 1},
    "exact_module": {
      "type": "object",
      "required": ["module", "tool", "version"],
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "slice_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "interface": {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        {"required": ["detector", "input", "oracle", "output"]},
        {"required": ["commands", "native_modules", "fixture", "oracle"]},
        {"required": ["detector", "input", "oracle", "output", "command", "parser", "offline_policy"]}
      ]
    },
    "schema_state_file_impact": {"type": "string", "minLength": 1},
    "tests": {
      "type": "object",
      "required": ["P", "N", "E", "M", "T", "O", "X", "F", "R", "B", "OR"],
      "properties": {
        "P": {"type": "string", "minLength": 1},
        "N": {"type": "string", "minLength": 1},
        "E": {"type": "string", "minLength": 1},
        "M": {"type": "string", "minLength": 1},
        "T": {"type": "string", "minLength": 1},
        "O": {"type": "string", "minLength": 1},
        "X": {"type": "string", "minLength": 1},
        "F": {"type": "string", "minLength": 1},
        "R": {"type": "string", "minLength": 1},
        "B": {"type": "string", "minLength": 1},
        "OR": {"type": "string", "minLength": 1},
        "terminal": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "resource_limits": {"type": "string", "minLength": 1},
    "success_state": {"type": "string", "minLength": 1},
    "failure_state": {"type": "string", "minLength": 1},
    "failure_consequence": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "real_benefit": {"type": "string", "minLength": 1},
    "non_extrapolation": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "r2_design": {"type": "object"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
