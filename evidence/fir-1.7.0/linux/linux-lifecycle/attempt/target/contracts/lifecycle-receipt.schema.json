{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/fir/r2/lifecycle-receipt.schema.json",
  "title": "FIR R2 lifecycle transaction receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cell_id",
    "fixture_digest",
    "operation",
    "before_tree_digest",
    "after_tree_digest",
    "discovery_receipt",
    "process_receipt",
    "file_residue_receipt",
    "network_receipt",
    "terminal_status",
    "failure_code",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "cell_id": {"type": "string", "pattern": "^SKILL:[A-Z_]+:[A-Z_]+$"},
    "fixture_digest": {"$ref": "#/$defs/digest"},
    "operation": {"enum": ["INSTALL", "DISCOVER", "UPGRADE", "UNINSTALL", "ROLLBACK"]},
    "before_tree_digest": {"$ref": "#/$defs/digest"},
    "after_tree_digest": {"$ref": "#/$defs/digest"},
    "discovery_receipt": {"type": "object"},
    "process_receipt": {"type": "object"},
    "file_residue_receipt": {
      "type": "object",
      "required": ["expected_residue", "observed_residue", "clean"],
      "properties": {
        "expected_residue": {"type": "array", "items": {"type": "string"}},
        "observed_residue": {"type": "array", "items": {"type": "string"}},
        "clean": {"type": "boolean"}
      }
    },
    "network_receipt": {"type": "object"},
    "terminal_status": {"enum": ["PASS", "BLOCKED", "UNSUPPORTED", "UNCOVERED"]},
    "failure_code": {"type": ["string", "null"]},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
