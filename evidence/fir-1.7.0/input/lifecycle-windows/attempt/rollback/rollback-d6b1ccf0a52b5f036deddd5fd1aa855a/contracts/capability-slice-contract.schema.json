{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/fir-enhancement/capability-slice-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_slice_id",
    "candidate_id",
    "exact_version",
    "license",
    "final_decision",
    "implementation_category",
    "implementation_order",
    "target_phase",
    "canonical_gap_ids",
    "goal",
    "entrypoint",
    "required_adapter",
    "adapter_manifest_sha256",
    "exact_command",
    "input_contract",
    "output_contract",
    "normalized_outcomes",
    "success_codes",
    "outcome_rules",
    "resource_limit",
    "network_policy",
    "offline_policy",
    "failure_status",
    "rollback",
    "files",
    "positive_evidence",
    "negative_evidence",
    "required_tests",
    "non_extrapolation",
    "compatibility",
    "implementation_cost",
    "runtime_cost",
    "maintenance_risk",
    "real_gain",
    "release_authority",
    "oracle_only"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "capability_slice_id": {"type": "string", "pattern": "^SLICE-[0-9a-f]{16}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "exact_version": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "final_decision": {"enum": ["ADMIT_CORE", "ADMIT_OPTIONAL", "ADMIT_CONDITIONAL", "EXTERNAL_ORACLE"]},
    "implementation_category": {"enum": ["inspect", "architecture", "verify", "plan", "repair", "close", "oracle"]},
    "implementation_order": {"type": "integer", "minimum": 1},
    "target_phase": {
      "enum": [
        "PHASE_0_ADAPTER_FOUNDATION",
        "PHASE_1_SYNTAX_AND_SYMBOLS",
        "PHASE_2_STATIC_SECURITY_ARCHITECTURE",
        "PHASE_3_TESTS_PROPERTIES_MUTATION",
        "PHASE_4_SUPPLY_CHAIN_AND_ORACLE",
        "PHASE_5_IMPACT_AND_REPAIR_PLANNING",
        "PHASE_6_DETERMINISTIC_REPAIR",
        "PHASE_7_CLOSURE_AND_REVIEW"
      ]
    },
    "canonical_gap_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "goal": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_adapter": {"type": "string", "minLength": 1},
    "adapter_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exact_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_contract": {"type": "string", "minLength": 1},
    "output_contract": {"type": "string", "minLength": 1},
    "normalized_outcomes": {
      "type": "array",
      "minItems": 5,
      "items": {"enum": ["FINDING", "CLEAN", "UNSUPPORTED", "UNCOVERED", "BLOCKED"]}
    },
    "success_codes": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "outcome_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["outcome", "exit_codes"],
        "properties": {
          "outcome": {"enum": ["FINDING", "CLEAN"]},
          "exit_codes": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
          "finding_kind": {"type": "string", "minLength": 1}
        }
      }
    },
    "resource_limit": {
      "type": "object",
      "required": [
        "memory_mib",
        "timeout_seconds",
        "max_input_files",
        "max_output_bytes",
        "max_concurrency",
        "retry_attempts"
      ],
      "properties": {
        "memory_mib": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_input_files": {"type": "integer", "minimum": 0},
        "max_output_bytes": {"type": "integer", "minimum": 1024},
        "max_concurrency": {"type": "integer", "minimum": 1},
        "retry_attempts": {"type": "integer", "minimum": 0}
      }
    },
    "network_policy": {"enum": ["DENY_EXTERNAL", "LOOPBACK_ONLY"]},
    "offline_policy": {"type": "string", "minLength": 1},
    "failure_status": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "positive_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_tests": {
      "type": "array",
      "minItems": 11,
      "items": {"type": "string"}
    },
    "non_extrapolation": {"type": "string", "minLength": 1},
    "compatibility": {"type": "string", "minLength": 1},
    "implementation_cost": {"type": "string", "minLength": 1},
    "runtime_cost": {"type": "object"},
    "maintenance_risk": {"type": "string", "minLength": 1},
    "real_gain": {"type": "string", "minLength": 1},
    "release_authority": {"const": false},
    "oracle_only": {"type": "boolean"}
  }
}
