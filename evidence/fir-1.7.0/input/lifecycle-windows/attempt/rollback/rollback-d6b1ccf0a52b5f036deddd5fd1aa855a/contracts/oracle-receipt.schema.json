{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/fir/r2/oracle-receipt.schema.json",
  "title": "FIR R2 independent oracle receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "oracle_id",
    "oracle_version",
    "cell_id",
    "snapshot_digest",
    "policy_digest",
    "detector_fact_ids",
    "recomputed_fact_digest",
    "comparison",
    "counterexample_refs",
    "terminal_status",
    "failure_code",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "oracle_id": {"type": "string", "minLength": 1},
    "oracle_version": {"type": "string", "minLength": 1},
    "cell_id": {"type": "string", "pattern": "^SKILL:[A-Z_]+:[A-Z_]+$"},
    "snapshot_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "detector_fact_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/digest"},
      "uniqueItems": true
    },
    "recomputed_fact_digest": {"$ref": "#/$defs/digest"},
    "comparison": {"enum": ["AGREE", "DISAGREE", "UNCOVERED", "UNSUPPORTED", "BLOCKED"]},
    "counterexample_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "terminal_status": {"enum": ["PASS", "BLOCKED", "UNSUPPORTED", "UNCOVERED"]},
    "failure_code": {"type": ["string", "null"]},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
