{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-inspection-repair.local/contracts/evidence-fact-v2.schema.json",
  "title": "FIR Evidence Fact V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fact_id",
    "run_id",
    "cell_id",
    "invariant_id",
    "defect_class_id",
    "subject_digest",
    "candidate_digest",
    "policy_digest",
    "registry_digest",
    "locator",
    "predicate",
    "value",
    "witness_refs",
    "method_id",
    "method_version",
    "producer_receipt_digest",
    "terminal_observation",
    "fact_digest"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "fact_id": { "$ref": "#/$defs/digest" },
    "run_id": { "type": "string", "minLength": 1 },
    "cell_id": { "type": "string", "pattern": "^SKILL:[A-Z_]+:[A-Z_]+$" },
    "invariant_id": { "type": "string", "minLength": 1 },
    "defect_class_id": { "type": "string", "minLength": 1 },
    "subject_digest": { "$ref": "#/$defs/digest" },
    "candidate_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "registry_digest": { "$ref": "#/$defs/digest" },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_byte", "end_byte"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 0 },
        "symbol": { "type": ["string", "null"] }
      }
    },
    "predicate": { "type": "string", "minLength": 1 },
    "value": {},
    "witness_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "method_id": { "type": "string", "minLength": 1 },
    "method_version": { "type": "string", "minLength": 1 },
    "producer_receipt_digest": { "$ref": "#/$defs/digest" },
    "terminal_observation": {
      "enum": ["FINDING", "CLEAN", "UNCOVERED", "UNSUPPORTED", "BLOCKED"]
    },
    "fact_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
