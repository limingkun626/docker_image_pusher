{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/fir-enhancement/capability-adapter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "slice_id",
    "candidate_id",
    "exact_version",
    "license",
    "command_template",
    "network_policy",
    "input_contract",
    "output_contract",
    "timeout_seconds",
    "memory_mib",
    "max_input_files",
    "max_output_bytes",
    "success_codes",
    "outcome_rules",
    "failure_statuses",
    "rollback_command",
    "invocation_allowlist",
    "excluded_features",
    "release_authority",
    "retry_policy",
    "finding_markers",
    "oracle_only",
    "output_format"
  ],
  "properties": {
    "adapter_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "pattern": "^SLICE-[0-9a-f]{16}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "exact_version": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "command_template": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "network_policy": {"enum": ["DENY", "OFFLINE_CACHE_ONLY", "LOOPBACK_ONLY"]},
    "input_contract": {"type": "string", "minLength": 1},
    "output_contract": {"type": "string", "minLength": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "memory_mib": {"type": "integer", "minimum": 16},
    "max_input_files": {"type": "integer", "minimum": 0},
    "max_output_bytes": {"type": "integer", "minimum": 1024},
    "success_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
    "outcome_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "exit_codes"],
        "properties": {
          "outcome": {"enum": ["FINDING", "CLEAN"]},
          "exit_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
          "finding_kind": {"type": "string", "minLength": 1}
        }
      }
    },
    "failure_statuses": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["UNSUPPORTED", "UNCOVERED", "BLOCKED"]}
    },
    "rollback_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "invocation_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "excluded_features": {"type": "array", "items": {"type": "string"}},
    "release_authority": {"const": false},
    "retry_policy": {
      "type": "object",
      "required": ["max_attempts", "backoff_seconds"],
      "properties": {
        "max_attempts": {"const": 0},
        "backoff_seconds": {"const": 0}
      }
    },
    "finding_markers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "oracle_only": {"type": "boolean"},
    "output_format": {"enum": ["JSON", "TEXT"]},
    "environment_overrides": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "rules_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "mutation_semantics": {"type": "boolean"},
    "json_root": {"enum": ["object", "array", null]},
    "json_required_fields": {
      "type": "array",
      "items": {"type": "string"}
    },
    "json_enum_fields": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string"}
      }
    },
    "json_array_item_required_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "network_enforcement": {
      "enum": ["ENV_PROXY", "WINDOWS_FIREWALL", "WSL_NETNS", "LOOPBACK_ONLY"]
    },
    "network_programs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "implementation_category": {"type": "string", "minLength": 1},
    "implementation_order": {"type": "integer", "minimum": 1},
    "target_phase": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"output_format": {"const": "JSON"}},
        "required": ["output_format"]
      },
      "then": {
        "required": ["json_root", "json_required_fields"],
        "properties": {
          "json_root": {"enum": ["object", "array"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "output_format": {"const": "JSON"},
          "json_root": {"const": "object"}
        },
        "required": ["output_format", "json_root"]
      },
      "then": {
        "properties": {
          "json_required_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "output_format": {"const": "JSON"},
          "json_root": {"const": "array"}
        },
        "required": ["output_format", "json_root"]
      },
      "then": {
        "required": ["json_array_item_required_fields"],
        "properties": {
          "json_array_item_required_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  ]
}
