{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/fir-enhancement/bounded-repair-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "base_candidate_digest",
    "issue_set_digest",
    "batch_digest",
    "operations",
    "fail_before",
    "fix_pass",
    "regression",
    "verification_matrix_digest",
    "single_repair_attempt",
    "automatic_reflow",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "base_candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "batch_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "fail_before": {"type": "object"},
    "fix_pass": {"type": "object"},
    "regression": {"type": "object"},
    "verification_matrix_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "single_repair_attempt": {"const": true},
    "automatic_reflow": {"const": false},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
