{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-inspection-repair.local/contracts/candidate-manifest-v2.schema.json",
  "title": "FIR Candidate Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "base_subject_digest",
    "candidate_digest",
    "candidate_dir_hash1",
    "repair_plan_digest",
    "operation_receipt_digests",
    "logical_identity",
    "generation",
    "files",
    "candidate_manifest_digest"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "candidate_id": { "$ref": "#/$defs/digest" },
    "base_subject_digest": { "$ref": "#/$defs/digest" },
    "candidate_digest": { "$ref": "#/$defs/digest" },
    "candidate_dir_hash1": { "$ref": "#/$defs/digest" },
    "repair_plan_digest": { "$ref": "#/$defs/digest" },
    "operation_receipt_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "logical_identity": { "type": "string", "minLength": 1 },
    "generation": { "const": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/digest" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "candidate_manifest_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
