{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-inspection-repair.local/contracts/knowledge-replay-receipt.schema.json",
  "title": "FIR Knowledge Replay Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "runner_id",
    "runner_version",
    "runner_digest",
    "signer_id",
    "issuer",
    "signature_receipt",
    "corpus_digest",
    "candidate_digest",
    "environment_digest",
    "tool_closure_digest",
    "pack_identity_digest",
    "requested_case_ids",
    "raw_results",
    "computed_counters",
    "redaction_receipt",
    "started_at",
    "finished_at",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": {
      "enum": ["MUTATION", "HISTORICAL_REPLAY", "SHADOW_REPLAY"]
    },
    "runner_id": { "type": "string", "minLength": 1 },
    "runner_version": { "type": "string", "minLength": 1 },
    "runner_digest": { "$ref": "#/$defs/digest" },
    "signer_id": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "signature_receipt": { "$ref": "#/$defs/signature_receipt" },
    "corpus_digest": { "$ref": "#/$defs/digest" },
    "candidate_digest": { "$ref": "#/$defs/digest" },
    "environment_digest": { "$ref": "#/$defs/digest" },
    "tool_closure_digest": { "$ref": "#/$defs/digest" },
    "pack_identity_digest": { "$ref": "#/$defs/digest" },
    "requested_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "raw_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/raw_result" }
    },
    "computed_counters": { "$ref": "#/$defs/counters" },
    "redaction_receipt": { "$ref": "#/$defs/redaction_receipt" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "receipt_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "signer_id",
        "issuer",
        "verification_method",
        "receipt_digest"
      ],
      "properties": {
        "receipt_id": { "type": "string", "minLength": 1 },
        "signer_id": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "verification_method": {
          "enum": ["sigstore-keyless", "ed25519-detached", "trusted-runner"]
        },
        "receipt_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "raw_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "outcome",
        "raw_payload",
        "raw_result_digest"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "outcome": {
          "enum": ["PASS", "FAIL", "TIMEOUT", "INFRA_ERROR", "UNSCORED", "MISSING"]
        },
        "raw_payload": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "raw_result_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "pass",
        "fail",
        "timeout",
        "infra_error",
        "unscored",
        "missing"
      ],
      "properties": {
        "case_count": { "type": "integer", "minimum": 1 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0 },
        "infra_error": { "type": "integer", "minimum": 0 },
        "unscored": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 }
      }
    },
    "redaction_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_digest", "output_digest"],
      "properties": {
        "policy_digest": { "$ref": "#/$defs/digest" },
        "output_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
