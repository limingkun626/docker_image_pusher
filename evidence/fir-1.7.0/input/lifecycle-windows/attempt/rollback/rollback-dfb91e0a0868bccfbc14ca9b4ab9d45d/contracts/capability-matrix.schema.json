{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-inspection-repair.local/contracts/capability-matrix.schema.json",
  "title": "FIR Capability Matrix V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_digest",
    "runtime_registry_digest",
    "execution_schema_digest",
    "adapter_schema_digest",
    "fixture_archive_sha256",
    "fixture_member_manifest_digest",
    "fixture_definition_digest",
    "tool_identity_digests",
    "runtime_closure_digests",
    "environment_digest",
    "evaluator_digest",
    "certification_row_digest",
    "rows",
    "row_count",
    "failures",
    "status",
    "matrix_digest"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "pack_digest": { "$ref": "#/$defs/digest" },
    "runtime_registry_digest": { "$ref": "#/$defs/digest" },
    "execution_schema_digest": { "$ref": "#/$defs/digest" },
    "adapter_schema_digest": { "$ref": "#/$defs/digest" },
    "fixture_archive_sha256": { "$ref": "#/$defs/digest" },
    "fixture_member_manifest_digest": { "$ref": "#/$defs/digest" },
    "fixture_definition_digest": { "$ref": "#/$defs/digest" },
    "tool_identity_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "runtime_closure_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "environment_digest": { "$ref": "#/$defs/digest" },
    "evaluator_digest": { "$ref": "#/$defs/digest" },
    "certification_row_digest": { "$ref": "#/$defs/digest" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "row_count": { "type": "integer", "minimum": 1 },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure" }
    },
    "status": { "enum": ["PASS", "BLOCKED"] },
    "matrix_digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "PASS" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "failures": { "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "BLOCKED" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "failures": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
    },
    "raw_receipt": {
      "type": "object",
      "minProperties": 1,
      "required": ["receipt_digest"],
      "properties": {
        "receipt_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": true
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_slice_id",
        "test_class",
        "status",
        "fixture_member_id",
        "fixture_tree_digest",
        "tool_identity_digest",
        "runtime_closure_digest",
        "command_digest",
        "semantic_assertion_digest",
        "raw_receipt",
        "row_digest"
      ],
      "properties": {
        "capability_slice_id": {
          "type": "string",
          "pattern": "^SLICE-[0-9a-f]{16}$"
        },
        "test_class": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "BLOCKED"] },
        "fixture_member_id": { "$ref": "#/$defs/relative_path" },
        "fixture_tree_digest": { "$ref": "#/$defs/digest" },
        "tool_identity_digest": { "$ref": "#/$defs/digest" },
        "runtime_closure_digest": { "$ref": "#/$defs/digest" },
        "command_digest": { "$ref": "#/$defs/digest" },
        "semantic_assertion_digest": { "$ref": "#/$defs/digest" },
        "raw_receipt": { "$ref": "#/$defs/raw_receipt" },
        "row_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_slice_id", "test_class", "error_code", "raw_evidence_digest"],
      "properties": {
        "capability_slice_id": {
          "type": "string",
          "pattern": "^SLICE-[0-9a-f]{16}$"
        },
        "test_class": { "type": "string", "minLength": 1 },
        "error_code": { "type": "string", "minLength": 1 },
        "raw_evidence_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
