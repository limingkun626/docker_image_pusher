{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-inspection-repair.local/contracts/semantic-cell-result.schema.json",
  "title": "FIR Semantic Cell Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cell_id",
    "target_kind",
    "category_id",
    "evidence_plane",
    "terminal_state",
    "binding_id",
    "binding_digest",
    "subject_digest",
    "scope_id",
    "fixture_ids",
    "detector_result",
    "oracle_result",
    "comparison",
    "semantic_fact_set_digest",
    "status",
    "failure_code",
    "resource_receipt",
    "process_tree_receipt",
    "network_guard_receipt",
    "recorded_at",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "cell_id": {
      "type": "string",
      "pattern": "^[A-Z_]+:[A-Z_]+:[A-Z_]+$"
    },
    "target_kind": { "enum": ["SKILL", "PLAN", "ARTICLE", "PROJECT", "OTHER"] },
    "category_id": {
      "enum": [
        "FUNCTIONAL_FAULT",
        "RISK_EXPOSURE",
        "LATENT_DEFECT",
        "VULNERABILITY",
        "OMISSION",
        "INCONSISTENCY",
        "BOUNDARY",
        "EXCEPTION_PATH",
        "OTHER_DECLARED"
      ]
    },
    "evidence_plane": {
      "enum": [
        "STATIC",
        "CONTRACT",
        "SEMANTIC",
        "BEHAVIOR",
        "RUNTIME",
        "SECURITY",
        "PERFORMANCE",
        "LIFECYCLE"
      ]
    },
    "terminal_state": {
      "enum": [
        "COVERED_BY_NATIVE_DETECTOR",
        "COVERED_BY_EXACT_ADAPTER",
        "COVERED_BY_INDEPENDENT_ORACLE",
        "MERGED_WITH_PRIMARY_CELL",
        "NOT_APPLICABLE_WITH_PROOF"
      ]
    },
    "binding_id": { "type": "string", "minLength": 1 },
    "binding_digest": { "$ref": "#/$defs/digest" },
    "subject_digest": { "$ref": "#/$defs/digest" },
    "scope_id": { "type": "string", "minLength": 1 },
    "fixture_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "detector_result": {
      "anyOf": [{ "$ref": "#/$defs/method_result" }, { "type": "null" }]
    },
    "oracle_result": {
      "anyOf": [{ "$ref": "#/$defs/method_result" }, { "type": "null" }]
    },
    "comparison": {
      "enum": [
        "AGREE",
        "AGREE_CLEAN",
        "NOT_COMPARED_ORACLE_ONLY",
        "NOT_COMPARED_EXACT_ADAPTER",
        "DISAGREE",
        "UNCOVERED",
        "BLOCKED"
      ]
    },
    "semantic_fact_set_digest": { "$ref": "#/$defs/digest" },
    "status": {
      "enum": ["CLEAN", "CLEAN_WITH_PROOF", "FINDING", "UNCOVERED", "UNSUPPORTED", "BLOCKED"]
    },
    "failure_code": { "type": ["string", "null"] },
    "resource_receipt": { "$ref": "#/$defs/execution_evidence" },
    "process_tree_receipt": { "$ref": "#/$defs/execution_evidence" },
    "network_guard_receipt": { "$ref": "#/$defs/execution_evidence" },
    "findings": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "not_applicable_proof": {
      "anyOf": [
        { "type": "object", "minProperties": 1, "additionalProperties": true },
        { "type": "null" }
      ]
    },
    "applicability": {
      "anyOf": [
        { "type": "object", "minProperties": 1, "additionalProperties": true },
        { "type": "null" }
      ]
    },
    "phase": { "enum": ["DISCOVERY", "VERIFICATION"] },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "receipt_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_key", "semantic_fact_digest", "witness_refs"],
      "properties": {
        "semantic_key": { "type": "string", "minLength": 1 },
        "semantic_fact_digest": { "$ref": "#/$defs/digest" },
        "witness_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "method_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "method_version",
        "result_digest",
        "facts",
        "raw_status",
        "error"
      ],
      "properties": {
        "method_id": { "type": "string", "minLength": 1 },
        "method_version": { "type": "string", "minLength": 1 },
        "result_digest": { "$ref": "#/$defs/digest" },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact" }
        },
        "raw_status": { "type": "string", "minLength": 1 },
        "error": { "type": ["string", "null"] },
        "raw_facts": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "execution_evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    }
  }
}
