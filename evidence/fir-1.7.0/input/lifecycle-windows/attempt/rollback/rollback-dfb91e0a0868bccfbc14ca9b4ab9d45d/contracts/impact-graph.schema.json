{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-inspection-repair.local/contracts/impact-graph.schema.json",
  "title": "FIR Impact Graph V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_digest",
    "candidate_digest",
    "source_closure_digest",
    "impact_scanner_registry_digest",
    "scanner_coverage_digest",
    "scanner_coverage",
    "opaque_sources",
    "unsupported_sources",
    "nodes",
    "edges",
    "imports",
    "consumer_evidence",
    "no_consumer_proofs",
    "finding_closure",
    "consumer_receipts",
    "graph_digest"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "subject_digest": { "$ref": "#/$defs/digest" },
    "candidate_digest": {
      "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "source_closure_digest": {
      "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "impact_scanner_registry_digest": { "$ref": "#/$defs/digest" },
    "scanner_coverage_digest": { "$ref": "#/$defs/digest" },
    "scanner_coverage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scanner_coverage" }
    },
    "opaque_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relative_path" }
    },
    "unsupported_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relative_path" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "imports": {
      "type": "array",
      "items": { "$ref": "#/$defs/import_record" }
    },
    "consumer_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "no_consumer_proofs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/no_consumer_proof" }
    },
    "finding_closure": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/finding_closure" }
    },
    "consumer_receipts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/consumer_receipt" }
      }
    },
    "graph_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
    },
    "observed_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_byte", "end_byte"],
      "properties": {
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 0 }
      }
    },
    "scanner_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "scanner_id",
        "scanner_version",
        "scanner_digest",
        "coverage_status",
        "observed_ranges",
        "edge_kinds",
        "failure_reason"
      ],
      "properties": {
        "locator": { "$ref": "#/$defs/relative_path" },
        "file_class": { "type": "string", "minLength": 1 },
        "scanner_id": { "type": "string", "minLength": 1 },
        "scanner_version": { "type": "string", "minLength": 1 },
        "scanner_digest": { "$ref": "#/$defs/digest" },
        "coverage_status": {
          "enum": ["SCANNED", "OPAQUE_RAW_ONLY", "UNSUPPORTED", "BLOCKED"]
        },
        "observed_ranges": {
          "type": "array",
          "items": { "$ref": "#/$defs/observed_range" }
        },
        "edge_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/edge_kind" }
        },
        "failure_reason": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "coverage_status": { "const": "SCANNED" } },
            "required": ["coverage_status"]
          },
          "then": {
            "properties": { "observed_ranges": { "minItems": 1 } }
          },
          "else": {
            "required": ["failure_reason"]
          }
        }
      ]
    },
    "edge_kind": {
      "enum": [
        "IMPORTS",
        "IMPORTS_DYNAMIC",
        "REFERENCES",
        "CONFIG_PATH",
        "SHELL_REFERENCE",
        "POWERSHELL_REFERENCE",
        "JS_IMPORT",
        "TEST_COMMAND",
        "LIFECYCLE_REFERENCE",
        "EXTERNAL_REFERENCE",
        "UNRESOLVED_IMPORT",
        "UNRESOLVED_REFERENCE",
        "AFFECTS",
        "COMMAND_REF",
        "CONFIG_REF",
        "TEST_REF",
        "RUNTIME_LOAD",
        "EXTERNAL_DEPENDENCY"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "risk_id": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/edge_kind" }
      }
    },
    "import_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "module", "line", "kind", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["INTERNAL", "EXTERNAL", "UNRESOLVED"] },
        "target": { "type": "string", "minLength": 1 },
        "dynamic": { "type": "boolean" }
      }
    },
    "scanned_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256"],
      "properties": {
        "locator": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "no_consumer_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "scope",
        "scanner_id",
        "scanner_digest",
        "scanner_registry_digest",
        "scanned_sources",
        "covered_file_classes",
        "opaque_sources",
        "unsupported_sources",
        "scanner_coverage_digest",
        "edge_count",
        "evidence_digest"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "NO_CONSUMERS" },
        "scope": { "type": "string", "minLength": 1 },
        "scanner_id": { "type": "string", "minLength": 1 },
        "scanner_digest": { "$ref": "#/$defs/digest" },
        "scanner_registry_digest": { "$ref": "#/$defs/digest" },
        "scanned_sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scanned_source" }
        },
        "covered_file_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "opaque_sources": { "maxItems": 0 },
        "unsupported_sources": { "maxItems": 0 },
        "scanner_coverage_digest": { "$ref": "#/$defs/digest" },
        "edge_count": { "type": "integer", "minimum": 0 },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "finding_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "affected", "consumers", "terminal_evidence"],
      "properties": {
        "status": { "enum": ["CLOSED", "UNRESOLVED", "OPEN_TERMINAL_EVIDENCE"] },
        "affected": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "terminal_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "consumer_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "command",
        "exit_code",
        "subject_digest",
        "verifier_id",
        "verifier_version",
        "verifier_sha256",
        "receipt_sha256"
      ],
      "properties": {
        "consumer": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "subject_digest": { "$ref": "#/$defs/digest" },
        "verifier_id": { "type": "string", "minLength": 1 },
        "verifier_version": { "type": "string", "minLength": 1 },
        "verifier_sha256": { "$ref": "#/$defs/digest" },
        "receipt_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
