{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-inspection-repair.local/contracts/risk-ledger-v2.schema.json",
  "title": "FIR Risk Ledger V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scope_digest",
    "subject_digest",
    "candidate_digest",
    "finding_schema_digest",
    "risk_ledger_schema_digest",
    "required_sources",
    "required_sources_digest",
    "observed_sources",
    "source_inventory_digest",
    "items",
    "open_count",
    "closed_count",
    "missing_sources",
    "unexpected_sources",
    "residual_risks",
    "unresolved_ids",
    "evidence_digests",
    "ledger_digest"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "scope_digest": { "$ref": "#/$defs/digest" },
    "subject_digest": { "$ref": "#/$defs/digest" },
    "candidate_digest": { "$ref": "#/$defs/digest" },
    "finding_schema_digest": { "$ref": "#/$defs/digest" },
    "risk_ledger_schema_digest": { "$ref": "#/$defs/digest" },
    "required_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_sources_digest": { "$ref": "#/$defs/digest" },
    "observed_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_inventory_digest": { "$ref": "#/$defs/digest" },
    "items": {
      "type": "array",
      "items": { "$ref": "https://full-inspection-repair.local/contracts/finding.schema.json" }
    },
    "open_count": { "type": "integer", "minimum": 0 },
    "closed_count": { "type": "integer", "minimum": 0 },
    "missing_sources": { "type": "array", "items": { "type": "string" } },
    "unexpected_sources": { "type": "array", "items": { "type": "string" } },
    "residual_risks": { "type": "array" },
    "unresolved_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_digests": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "minProperties": 1
    },
    "ledger_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
